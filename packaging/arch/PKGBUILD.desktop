# Maintainer: Your Name <your@email.com>
pkgname=hyprshare-desktop
pkgver=0.6.0
pkgrel=1
pkgdesc="Native desktop front-end for hyprshare (Tauri GUI)"
arch=('x86_64')
url="https://github.com/yourusername/hyprshare"
license=('GPL-3.0-only')
depends=(
  'hyprshare'
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
)
makedepends=(
  'cargo'
  'rust'
  'nodejs'
  'npm'
  'webkit2gtk-4.1'
  'gtk3'
  'librsvg'
  'imagemagick'
  'pkgconf'
)
source=("hyprshare-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  # web/dist is gitignored, so it is not in the source tarball: build the
  # frontend explicitly before embedding it into the Rust binary.
  cd "hyprshare-$pkgver/web"
  npm install
  npm run build

  cd "../desktop/src-tauri"
  cargo build --release
}

package() {
  cd "hyprshare-$pkgver"

  install -Dm755 \
    "desktop/src-tauri/target/release/hyprshare-desktop" \
    "$pkgdir/usr/bin/hyprshare-desktop"

  install -Dm644 \
    "desktop/hyprshare.desktop" \
    "$pkgdir/usr/share/applications/hyprshare.desktop"

  # Scalable icon for the .desktop entry.
  install -Dm644 \
    "desktop/src-tauri/icons/icon.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/hyprshare.svg"
  for size in 32 128 256; do
    case "$size" in
      256) src="128x128@2x.png" ;;
      *)   src="${size}x${size}.png" ;;
    esac
    install -Dm644 \
      "desktop/src-tauri/icons/$src" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/hyprshare.png"
  done
}
