# Maintainer: polarours <polarours@zohomail.com>
pkgname=hyprshare
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux-native sharing platform for Hyprland and Wayland (CLI, TUI, desktop GUI and web UI)"
arch=('x86_64')
url="https://github.com/polarours/hyprshare"
license=('GPL-3.0-only')
depends=(
  'openssl' 'sdbus-cpp' 'pipewire' 'gcc-libs' 'glibc'
  'webkit2gtk-4.1' 'gtk3'
)
makedepends=(
  'cmake' 'ninja'
  'cargo' 'rust' 'nodejs' 'npm' 'pkgconf'
)
optdepends=('avahi: mDNS discovery support')
source=("hyprshare-$pkgver.tar.gz::https://github.com/polarours/hyprshare/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a07426002547617f7ee3f2e0a6bd28be88444fbc26a52fca0345a7fe3bd9bfb4')

build() {
  cd "$pkgname-$pkgver"

  # C++ CLI + daemon (tests built for check()).
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build

  # Web frontend (embedded into the GUI, also served by `hyprshare web serve`).
  cd web && npm ci && npm run build && cd ..

  # Tauri GUI.
  cd desktop/src-tauri && cargo build --release --locked && cd ../..

  # Terminal UI.
  cd tui && cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"

  # Installs the CLI, the daemon, the shell completions, the systemd units and
  # the launcher integration (.desktop entries plus hicolor icons).
  DESTDIR="$pkgdir" cmake --install build

  # Desktop GUI and terminal UI come from the Rust builds, which CMake does not
  # drive, so they are installed here.
  install -Dm755 desktop/src-tauri/target/release/hyprshare-desktop "$pkgdir/usr/bin/hyprshare-desktop"
  install -Dm755 tui/target/release/hyprshare-tui "$pkgdir/usr/bin/hyprshare-tui"

  # Web frontend served by `hyprshare web serve`.
  install -d "$pkgdir/usr/share/hyprshare"
  cp -r web/dist "$pkgdir/usr/share/hyprshare/web"
}

post_install() {
  # pacman hooks normally cover this; keep it working when they are absent.
  update-desktop-database -q usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
}

post_upgrade() {
  post_install
}
