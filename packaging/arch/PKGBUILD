# Maintainer: polarours <polarours@outlook.com>
pkgname=hyprshare
pkgver=0.6.0
pkgrel=1
pkgdesc="Linux-native sharing platform for Hyprland and Wayland environments (CLI and daemon)"
arch=('x86_64')
url="https://github.com/polarours/hyprshare"
license=('GPL-3.0-only')
depends=('openssl' 'sdbus-cpp' 'pipewire' 'gcc-libs' 'glibc')
makedepends=('cmake' 'ninja')
optdepends=(
  'avahi: mDNS discovery support'
  'hyprshare-desktop: native GUI front-end'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/polarours/hyprshare/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
